{
  "custom": {},
  "params": {},
  "props": {
    "defaultSize": {
      "height": 50,
      "width": 1400
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Title"
        },
        "position": {
          "grow": 1,
          "shrink": 0
        },
        "props": {
          "style": {
            "color": "#FFFFFF",
            "fontSize": "18px",
            "fontWeight": "bold"
          },
          "text": "Brevent Hydraulics · Annecy · Finishing area (FIN)"
        },
        "type": "ia.display.label"
      },
      {
        "meta": {
          "name": "ToggleTheme"
        },
        "position": {
          "basis": "96px"
        },
        "propConfig": {
          "props.label.text": {
            "binding": {
              "config": {
                "expression": "if({this.props.selected}, \"Dark\", \"Light\")"
              },
              "type": "expr"
            }
          },
          "props.selected": {
            "binding": {
              "config": {
                "expression": "{session.props.theme}\u003d \"dark\""
              },
              "type": "expr"
            },
            "onChange": {
              "enabled": null,
              "script": "\tself.session.props.theme \u003d \"dark\" if currentValue.value else \"light\""
            }
          }
        },
        "props": {
          "label": {}
        },
        "type": "ia.input.toggle-switch"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.navigate(\u0027/\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Overview"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "props": {
          "primary": false,
          "style": {
            "marginLeft": "8px"
          },
          "text": "Overview"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.navigate(\u0027/kpi\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Kpi"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "props": {
          "primary": false,
          "style": {
            "marginLeft": "8px"
          },
          "text": "KPI"
        },
        "type": "ia.input.button"
      },
      {
        "events": {
          "dom": {
            "onClick": {
              "config": {
                "script": "\tsystem.perspective.navigate(\u0027/instructor\u0027)"
              },
              "scope": "G",
              "type": "script"
            }
          }
        },
        "meta": {
          "name": "Instructor"
        },
        "position": {
          "basis": "120px",
          "shrink": 0
        },
        "props": {
          "primary": false,
          "style": {
            "marginLeft": "8px"
          },
          "text": "Instructor"
        },
        "type": "ia.input.button"
      },
      {
        "meta": {
          "name": "Clock"
        },
        "position": {
          "basis": "170px",
          "shrink": 0
        },
        "propConfig": {
          "props.text": {
            "binding": {
              "config": {
                "expression": "dateFormat(now(1000), \u0027dd/MM/yyyy HH:mm:ss\u0027)"
              },
              "type": "expr"
            }
          }
        },
        "props": {
          "style": {
            "color": "#FFFFFF",
            "marginLeft": "16px",
            "textAlign": "right"
          }
        },
        "type": "ia.display.label"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "alignItems": "center",
      "style": {
        "alignItems": "center",
        "backgroundColor": "#2B3A4A",
        "padding": "6px 12px"
      }
    },
    "type": "ia.container.flex"
  }
}