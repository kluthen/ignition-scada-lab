{
  "name": "Ignition lab",
  "dockerComposeFile": ["../compose.yaml"],
  "service": "workspace",
  "runServices": ["gateway-init", "gateway", "db", "plc-c01", "plc-c02", "plc-c03", "plc-c04", "plc-c05", "plc-c06", "workspace"],
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "dev",
  "forwardPorts": ["gateway:8088", "db:5432"],
  "portsAttributes": {
    "gateway:8088": { "label": "Ignition Gateway and Perspective" },
    "db:5432": { "label": "PostgreSQL" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "redhat.vscode-yaml"]
    }
  }
}
