# Copy to .env and adjust. Read by docker compose (and the devcontainer).
HOST_UID=1000
HOST_GID=1000
TZ=Europe/Paris
IGNITION_VERSION=8.3.10
IGNITION_EDITION=standard
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-me
IGNITION_LICENSE_KEY=
IGNITION_ACTIVATION_TOKEN=

# HOST_UID/HOST_GID: your `id -u` / `id -g`. The gateway starts as root, chowns
#   its install to this uid and drops to it, so ignition/data is editable from the host.
# IGNITION_EDITION: maker (the lab's choice, needs the two values below) |
#   standard (full trial, 2 h resets) | edge. Applied only when the gateway is
#   commissioned: changing it means a fresh data dir (docs/system/operations.md).
#   It is fixed at first commissioning: to switch, stop the stack and empty ignition/data.
# Maker Edition only: license key and activation token from your IA account
#   (https://inductiveautomation.com/ignition/maker-edition).

# PostgreSQL (service "db", reachable from the gateway as db:5432, from the host as 127.0.0.1:5432)
POSTGRES_VERSION=19
POSTGRES_DB=mes
POSTGRES_USER=ignition
POSTGRES_PASSWORD=change-me

# Windows PC used as the PLC engineering station (docs/system/plc-engineering.md):
# SSH alias (from ~/.ssh/config) used by scripts/plc-pc, address the gateway
# container uses to reach the simulated PLCs (a stable one: Tailscale or fixed
# LAN IP), and the training folder on the PC.
PLC_PC_SSH=my-windows-pc
PLC_PC_HOST=192.0.2.10
PLC_PC_DIR=C:/PLC-Training
